# Salin menjadi pipeline/.env (tidak masuk git). Dibaca otomatis oleh `dagster dev` dari folder pipeline/.
DATABASE_URL="postgresql://USER@localhost:5432/terawang"
# berkas = pakai CSV/JSON yang ada di repo; siskaperbapo = unduh harga baru setiap run; manual = repo + unggahan
TERAWANG_SUMBER_HARGA=berkas
# folder unduhan mode siskaperbapo (di luar repo); default ~/.local/share/terawang/harga_beras
# TERAWANG_HARGA_DIR=
# berkas = pakai src/lib/gee_wilayah.json; gee = jalankan Earth Engine (butuh GEE_PROJECT dan kredensial)
TERAWANG_SUMBER_CITRA=berkas
GEE_PROJECT=
# berkas keluaran mode gee (di luar repo); default ~/.local/share/terawang/gee_wilayah.json
# TERAWANG_GEE_JSON=
# deret titik sawah K1 yang diperpanjang di mode gee; default ~/.local/share/terawang/titik
# TERAWANG_TITIK_DIR=
# taksiran citra K1 bulan operasional; default ~/.local/share/terawang/k1
# TERAWANG_K1_DIR=
# key WebAPI BPS (https://webapi.bps.go.id/developer/); dipakai mode webapi (BPS) dan jda (Bulog). Jangan masukkan ke git.
BPS_WEBAPI_KEY=
# berkas = CSV repo; webapi = WebAPI BPS; manual = repo + unggahan
TERAWANG_SUMBER_BPS=berkas
# berkas = CSV repo; jda = PDF Provinsi Jawa Timur Dalam Angka edisi terbaru; manual = repo + unggahan
TERAWANG_SUMBER_BULOG=berkas
# lapisan hasil konektor BPS/Bulog (struktur sama dengan data/); default ~/.local/share/terawang/data
# TERAWANG_DATA_DIR=
# unggahan manual per sumber: <dir>/{bps,bulog,harga,jarak}/<nama berkas repo>; default ~/.local/share/terawang/manual
# TERAWANG_MANUAL_DIR=
