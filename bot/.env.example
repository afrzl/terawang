# Koneksi ke DB terawang memakai role khusus bot (lihat sql/role-bot.sql)
DATABASE_URL=postgresql://terawang_bot:GANTI@postgres:5432/terawang

# GoWA (nilai dari ~/terawang-wa/.env)
GOWA_URL=http://terawang-gowa:3000
GOWA_BASIC_AUTH=admin:GANTI
WHATSAPP_WEBHOOK_SECRET=GANTI
# GOWA_DEVICE_ID=   # isi bila GoWA punya lebih dari satu device

# OpenAI untuk pesan bebas. Kosongkan OPENAI_API_KEY = bot hanya melayani perintah baku.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=minimal
LLM_BATAS_HARIAN=20        # pesan bebas per nomor per hari
LLM_BATAS_10MENIT=5        # pesan bebas per nomor per 10 menit
LLM_TOKEN_HARIAN=300000    # anggaran token seluruh bot per hari
LLM_MAKS_KELUARAN=700      # token keluaran per panggilan
LLM_MAKS_MASUKAN=400       # karakter pesan yang boleh diteruskan ke LLM
LLM_CACHE_MENIT=30         # pertanyaan sama dijawab dari cache

# Siaran peringatan
SIARAN_AKTIF=1
SIARAN_INTERVAL_MENIT=10

# HET beras medium cadangan bila app.ambang_harga kosong
HET_MEDIUM=13500

# Nomor admin (628xx), dipisah koma
ADMIN_WA=

# Token untuk POST /api/tanya (simulator dasbor). Kosong = mati.
BOT_API_TOKEN=

# LOG_WEBHOOK=1   # cetak payload webhook mentah untuk debug

# Hak bot = hak peran Tamu di admin (Akun & peran). Dibaca tiap 60 detik; gagal = pakai hak terakhir/isi awal Tamu.
HAK_URL=https://terawang.tech/admin/api/hak/tamu
